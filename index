 document.getElementById('vnote').textContent=voice?'':'⚠️ 영어 음성이 없어요. 기기 설정에서 영어(미국) 음성을 켜 주세요.'}catch(e){}}
try{speechSynthesis.onvoiceschanged=pick;pick()}catch(e){}
function say(t,r,cb){try{speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(t.replace(/-/g,' '));u.lang='en-US';if(voice)u.voice=voice;u.rate=r||0.75;u.pitch=1.1;if(cb)u.onend=cb;speechSynthesis.speak(u)}catch(e){if(cb)cb()}}
function show(id){['home','learn','game'].forEach(function(x){document.getElementById(x).classList.toggle('hidden',x!==id)});if(id==='learn'){P=pool();i=0;render()}if(id==='game')startGame()}
function cur(){return P[i]}
function render(){var x=cur();lemoji.textContent=x.e;lword.textContent=x.w.replace(/-/g,' ');lko.textContent=x.k;lmsg.textContent='';lcount.textContent=(i+1)+' / '+P.length;say(x.w)}
function move(d){i=(i+d+P.length)%P.length;render()}
function repeat(){lmsg.textContent='👂 잘 들어봐요';say(cur().w,0.6,function(){lmsg.textContent='🎤 이제 크게 따라 말해요!';setTimeout(function(){lmsg.textContent='⭐ 잘했어요! Great! ⭐';lmsg.classList.remove('pop');void lmsg.offsetWidth;lmsg.classList.add('pop');say('Great job!',0.85)},3000)})}
function shuffle(a){return a.slice().sort(function(){return Math.random()-.5})}
function startGame(){P=pool();round=0;score=0;end.classList.add('hidden');choices.classList.remove('hidden');next()}
function next(){locked=false;gmsg.textContent='';gstars.textContent='⭐'.repeat(score);
 if(round>=ROUNDS){choices.classList.add('hidden');end.classList.remove('hidden');say('Wow! You did it!',0.85);return}
 var s=shuffle(P);target=s[0];var o=[target],seen={};seen[target.e]=1;
 for(var k=1;k<s.length&&o.length<3;k++){if(!seen[s[k].e]){seen[s[k].e]=1;o.push(s[k])}}
 choices.innerHTML='';shuffle(o).forEach(function(x){var d=document.createElement('div');d.className='choice';d.textContent=x.e;d.onclick=function(){answer(x,d)};choices.appendChild(d)});
 setTimeout(function(){say(target.w)},300)}
function answer(x,d){if(locked)return;
 if(x===target){locked=true;score++;round++;gmsg.textContent='🎉 정답! '+x.w.replace(/-/g,' ');d.classList.add('pop');gstars.textContent='⭐'.repeat(score);say('Yes! '+x.w,0.8,function(){setTimeout(next,500)})}
 else{d.classList.remove('shake');void d.offsetWidth;d.classList.add('shake');gmsg.textContent='🤔 다시 들어봐요';gmsg.style.color='#ff7aa8';setTimeout(function(){gmsg.style.color='';say(target.w)},500)}}
document.addEventListener('click',function(){if(!voice)pick()},{once:true});
</script>
